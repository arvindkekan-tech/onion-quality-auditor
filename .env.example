# ONIVIS Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# NEVER commit real secret values to source control.

# Application Environment
ONIVIS_APP_NAME="ONIVIS API"
ONIVIS_ENV="production"  # local | staging | production

# Supabase Integration (Leave empty to use automatic local SQLite fallback)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="inspection-images"

# Authentication
JWT_SECRET="your-secure-random-secret-key"

# AI / ML Inference Engine
ANALYSIS_PROVIDER="real"  # "real" for live YOLO inference; "demo" for testing
DEVICE="cpu"              # "cpu" or "cuda"
DETECTION_CONF="0.10"
CLASSIFICATION_CONF_THRESHOLD="0.50"

# Model File Paths (Defaults to backend/models/detection_model.pt and best_classification_model.pt)
DETECTION_MODEL_PATH="models/detection_model.pt"
CLASSIFICATION_MODEL_PATH="models/best_classification_model.pt"

# Physical Tray Calibration (500mm x 500mm standard APMC sampling grid)
WINDOW_WIDTH_MM="500.0"
WINDOW_HEIGHT_MM="500.0"

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,https://onivis-frontend.onrender.com"
