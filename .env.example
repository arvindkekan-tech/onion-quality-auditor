# ONIVIS Frontend Environment Configuration Example
# Copy this file to .env.local and configure your values.

# Backend API Base URL
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Mock Mode (false for production live API)
VITE_USE_MOCK_API="false"

# Supabase Public Anonymous Configuration (Optional; Auth handled through backend)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
